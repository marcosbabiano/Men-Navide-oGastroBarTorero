{
  "name": "gastrobar-torero-navidad-2026",
  "private": true,
  "version": "1.0.0",
  "description": "Landing de los menús de Navidad 2026 de GastroBar Torero con panel de administración (Netlify Functions + Blobs + Identity).",
  "type": "module",
  "engines": {
    "node": ">=20.12"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --pretty",
    "lint": "eslint .",
    "test": "vitest run",
    "test:e2e": "playwright test --trace off",
    "local": "tsx scripts/local-server.ts",
    "images": "node scripts/prepare-images.mjs",
    "check": "npm run typecheck && npm run lint && npm run test && npm run build"
  },
  "dependencies": {
    "@netlify/blobs": "11.1.8",
    "@netlify/cache": "4.2.1",
    "@netlify/identity": "2.0.1",
    "gsap": "3.15.1",
    "image-size": "2.1.0",
    "jspdf": "4.2.1",
    "konva": "10.9.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-konva": "19.3.2",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@dnd-kit/core": "6.3.1",
    "@dnd-kit/sortable": "10.0.0",
    "@dnd-kit/utilities": "3.2.2",
    "@eslint/js": "9.39.5",
    "@netlify/edge-functions": "4.0.4",
    "@netlify/functions": "6.1.1",
    "@playwright/test": "1.63.0",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "5.2.0",
    "eslint": "9.39.5",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.14.0",
    "immer": "11.2.9",
    "sharp": "0.35.5",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.1",
    "vite": "7.3.7",
    "vitest": "4.1.12"
  }
}
